# Masters Pool — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── The Odds API ──────────────────────────────────────────────────────────────
# Sign up FREE at https://the-odds-api.com (500 req/month on free tier)
# Used for live FanDuel/DraftKings odds during the tournament.
# Without this key, the app uses static pre-tournament FanDuel odds.
ODDS_API_KEY=your_api_key_here
